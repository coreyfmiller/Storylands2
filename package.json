    "create": "node scripts/create-book.mjs",
    "illustrate": "node scripts/generate-book.mjs",
    "audit:text": "node scripts/audit-text.mjs",
    "art": "node scripts/optimize-art.mjs",
    "books": "node scripts/optimize-books.mjs --prune"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@vercel/analytics": "1.6.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "next": "16.3.3",
    "react": "^19",
    "react-dom": "^19",
    "shadcn": "^4.11.0",
    "tailwind-merge": "^3.3.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "postcss": "^8.5",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.3.3",
    "typescript": "5.7.3"
  }
