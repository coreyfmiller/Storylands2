{
  "name": "storylands",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"scripts/__tests__/*.test.mjs\" \"lib/__tests__/*.test.ts\"",
    "check": "npm run test && node scripts/audit-text.mjs && tsc --noEmit && next build",
