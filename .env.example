# Storylands2 — environment template. Copy to .env.local and fill in real values.
# .env.local is gitignored and must never be committed.

# OpenAI (server-side only). Used for the image pipeline (gpt-image) and the authoring
# pipeline (Responses API). Never expose this to the client.
OPENAI_API_KEY=

# Optional overrides (leave blank to use code defaults):
# IMAGE_PROVIDER=openai
# OPENAI_IMAGE_MODEL=
